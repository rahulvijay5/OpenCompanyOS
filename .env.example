NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opencompanyos
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# LiteLLM proxy (OpenAI-compatible). See litellm.config.yaml and https://docs.litellm.ai/docs/
# CHAT_MODEL / EMBEDDING_MODEL are model_name aliases, not provider SDK names.
LITELLM_BASE_URL=http://localhost:4001/v1
LITELLM_API_KEY=sk-local-dev
CHAT_MODEL=gemini
EMBEDDING_MODEL=embedding
EMBEDDING_DIMENSIONS=768
GEMINI_API_KEY=
GROQ_API_KEY=

LOG_LEVEL=debug
